{
  "name": "rtsp-player-server",
  "version": "1.0.0",
  "description": "Play RTSP IP cameras in the browser: tiny WebSocket relay (ffmpeg → fragmented MP4) for react-rtsp-player. ffmpeg included.",
  "keywords": [
    "rtsp",
    "ip camera",
    "cctv",
    "stream",
    "ffmpeg",
    "websocket",
    "mse",
    "fmp4",
    "live",
    "relay",
    "server"
  ],
  "license": "MIT",
  "author": "FeruzDev",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FeruzDev/rtsp-player.git",
    "directory": "packages/server"
  },
  "homepage": "https://github.com/FeruzDev/rtsp-player#readme",
  "bugs": {
    "url": "https://github.com/FeruzDev/rtsp-player/issues"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "rtsp-player-server": "dist/cli.cjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.3"
  },
  "scripts": {
    "build": "tsup"
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "ws": "^8.22.2"
  },
  "publishConfig": {
    "access": "public"
  }
}
